<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/backgrund_image"
    android:orientation="vertical"
    tools:context=".activities.Khatm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_16sdp"
        android:paddingEnd="@dimen/_16sdp"
        tools:ignore="UselessParent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="خەتــــــــــــم"
            android:textSize="@dimen/_20sdp"
            android:fontFamily="@font/rabar015"
            android:gravity="center"
            android:textColor="@color/textColorBlack"
            android:layout_weight="1"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:scrollbarSize="@dimen/_10sdp"
        android:layout_gravity="center"
        android:scrollbarThumbVertical="@drawable/scroll_bar"
        tools:ignore="SpeakableTextPresentCheck">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_margin="@dimen/_2sdp">


            <LinearLayout
                android:id="@+id/LayoutClous"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible"
                android:layout_margin="@dimen/_2sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="جۆری پلان"
                android:textColor="@color/textColorBlack"
                android:textSize="@dimen/_14sdp"
                android:fontFamily="@font/rabar015"
                android:layout_gravity="center"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/btnModeJuz"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/btn_yes_bg"
                    android:fontFamily="@font/rabar015"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="بە جوزء"
                    android:textColor="@color/textColorWhite"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/btnModeDaily"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/backgrownd_btn_taf"
                    android:fontFamily="@font/rabar015"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="پلانی ڕۆژانە"
                    android:textColor="@color/textColorBlack"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/juzModeSetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:id="@+id/txtSetupTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ئەتەوێت لە مانگێکدا چەند جار خەتم بکەیت ؟"
                android:textColor="@color/textColorBlack"
                android:textSize="@dimen/_18sdp"
                android:fontFamily="@font/rabar015"
                android:textAlignment="center"
                android:layout_gravity="center"
                />
        <LinearLayout
            android:id="@+id/juzPlusMinusRow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_margin="@dimen/_2sdp">





            <TextView
                android:id="@+id/txtKhatmNUmber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textAlignment="center"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:fontFamily="@font/rabar015"
                android:layout_margin="@dimen/_10sdp"
                android:elevation="8dp"
                android:background="@drawable/number_back"
                android:paddingBottom="@dimen/_1sdp"
                android:paddingTop="@dimen/_1sdp"
                android:textColor="@color/textColorBlack"
                android:textSize="@dimen/_18sdp"
                />

            <ImageView
                android:id="@+id/plusBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_upward"
                android:background="@drawable/backgrownd_btn_taf"
                android:padding="7dp"
                android:elevation="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_7sdp"
                android:layout_gravity="center"
                />

            <ImageView
                android:id="@+id/minusBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_downward"
                android:background="@drawable/backgrownd_btn_taf"
                android:padding="7dp"
                android:elevation="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_3sdp"
                android:layout_marginEnd="@dimen/_7sdp"
                android:layout_gravity="center"
                />
        </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dailyModeSetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ماوەی خەتم (ڕۆژ)"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/_16sdp"
                    android:fontFamily="@font/rabar015"
                    tools:ignore="HardcodedText" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp">

                    <TextView android:id="@+id/chipDays7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="3dp" android:background="@drawable/backgrownd_btn_taf" android:fontFamily="@font/rabar015" android:padding="8dp" android:text="٧" android:textColor="@color/textColorBlack" tools:ignore="HardcodedText" />
                    <TextView android:id="@+id/chipDays15" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="3dp" android:background="@drawable/backgrownd_btn_taf" android:fontFamily="@font/rabar015" android:padding="8dp" android:text="١٥" android:textColor="@color/textColorBlack" tools:ignore="HardcodedText" />
                    <TextView android:id="@+id/chipDays30" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="3dp" android:background="@drawable/btn_yes_bg" android:fontFamily="@font/rabar015" android:padding="8dp" android:text="٣٠" android:textColor="@color/textColorWhite" tools:ignore="HardcodedText" />
                    <TextView android:id="@+id/chipDays60" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="3dp" android:background="@drawable/backgrownd_btn_taf" android:fontFamily="@font/rabar015" android:padding="8dp" android:text="٦٠" android:textColor="@color/textColorBlack" tools:ignore="HardcodedText" />
                    <TextView android:id="@+id/chipDaysFree" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="3dp" android:background="@drawable/backgrownd_btn_taf" android:fontFamily="@font/rabar015" android:padding="8dp" android:text="ئازاد" android:textColor="@color/textColorBlack" tools:ignore="HardcodedText" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtDailyPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/rabar014"
                    android:gravity="center"
                    android:text="هەر «تەواو» ≈ ١ جزء"
                    android:textColor="@color/second_text_color"
                    android:textSize="13sp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ڕێکخستنی ئاگەدار کەرەوە."
                android:textColor="@color/textColorBlack"
                android:textSize="@dimen/_13sdp"
                android:fontFamily="@font/rabar015"
                android:textAlignment="center"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_margin="@dimen/_2sdp">

            <Switch
                android:id="@+id/NotifiSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_8sdp"
                android:fontFamily="@font/rabar014"
                android:text="چارەکێک دوای بانگەکان"
                android:textSize="@dimen/_13sdp"
                android:layout_gravity="end"
                android:textColor="@color/textColorBlack"
                tools:ignore="HardcodedText,TouchTargetSizeCheck,UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/NotifiSwitchHour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_8sdp"
                android:fontFamily="@font/rabar014"
                android:text="چارەکێک پێش بانگەکان"
                android:textSize="@dimen/_13sdp"
                android:layout_gravity="end"
                android:textColor="@color/textColorBlack"
                tools:ignore="HardcodedText,TouchTargetSizeCheck,UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/NotifiSwitchEveryEsha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_8sdp"
                android:fontFamily="@font/rabar014"
                android:text="هەمیشە دوای بانگی عیشا"
                android:textSize="@dimen/_13sdp"
                android:layout_gravity="end"
                android:textColor="@color/textColorBlack"
                tools:ignore="HardcodedText,TouchTargetSizeCheck,UseSwitchCompatOrMaterialXml" />



            <Switch
                android:id="@+id/Notifi2Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_8sdp"
                android:fontFamily="@font/rabar014"
                android:text="یەکجار "
                android:visibility="gone"
                android:textSize="@dimen/_13sdp"
                android:textColor="@color/textColorBlack"
                tools:ignore="HardcodedText,TouchTargetSizeCheck,UseSwitchCompatOrMaterialXml" />



        </LinearLayout>

                <TextView
                    android:id="@+id/txtStartNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="دەستپێبکە"
                    android:layout_margin="@dimen/_10sdp"
                    android:background="@drawable/btn_yes_bg"
                    android:paddingEnd="@dimen/_15sdp"
                    android:paddingStart="@dimen/_15sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:paddingTop="@dimen/_3sdp"
                    android:fontFamily="@font/rabar014"
                    android:textColor="@color/textColorWhite"
                    android:textSize="@dimen/_18sdp"
                    android:textAlignment="center"
                    android:layout_gravity="center"
                    />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/LayoutStart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:gravity="center"
            android:visibility="gone"
            android:layout_margin="@dimen/_2sdp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:gravity="center"
                android:elevation="@dimen/_6sdp"
                android:background="@drawable/background_khatm_card"
                android:layout_margin="@dimen/_8sdp">

                <TextView
                    android:id="@+id/juzzStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_8sdp"
                    android:text="جوزئی 1"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/_18sdp"
                    android:fontFamily="@font/rabar015"
                    android:textAlignment="textEnd"
                    android:layout_gravity="end"
                    />
                <TextView
                    android:id="@+id/AyaStart"
                    android:layout_width="200dp"
                    android:layout_height="32dp"
                    android:layout_margin="@dimen/_8sdp"
                    android:text="بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/_14sdp"
                    android:fontFamily="@font/al_qalam_quran_majeed"
                    android:textAlignment="center"
                    android:layout_gravity="center"
                    />
               <TextView
                   android:id="@+id/SuraStart"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="لە سُورَةُ الفَاتِحَةِ ئایەتی 1 لاپەڕە 1"
                   android:textColor="@color/textColorBlack"
                   android:textSize="@dimen/_14sdp"
                   android:fontFamily="@font/rabar015"
                   android:layout_marginTop="@dimen/_13sdp"
                   android:layout_marginEnd="@dimen/_8sdp"
                   android:layout_marginStart="@dimen/_8sdp"
                   android:textAlignment="textEnd"
                   android:layout_gravity="end"
                   />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:background="@color/textColorBlack"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:alpha="0.2"
                    android:layout_marginBottom="@dimen/_3sdp"

                    />
                <TextView
                   android:id="@+id/SuraEnd"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_marginBottom="@dimen/_13sdp"
                   android:layout_marginEnd="@dimen/_8sdp"
                   android:layout_marginStart="@dimen/_8sdp"
                   android:text="بۆ سُورَةُ البَقَرَةِِ ئایەتی 141 لاپەڕە 21"
                   android:textColor="@color/textColorBlack"
                   android:textSize="@dimen/_14sdp"
                   android:fontFamily="@font/rabar015"
                   android:textAlignment="textEnd"
                   android:layout_gravity="end"
                   />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_margin="@dimen/_2sdp">



                <TextView
                    android:id="@+id/txtStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="خوێندنەوە"
                    android:layout_margin="@dimen/_10sdp"
                    android:background="@drawable/btn_yes_bg"
                    android:paddingEnd="@dimen/_15sdp"
                    android:paddingStart="@dimen/_15sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:paddingTop="@dimen/_3sdp"
                    android:fontFamily="@font/rabar015"
                    android:textColor="@color/textColorWhite"
                    android:textSize="@dimen/_18sdp"
                    android:textAlignment="center"
                    android:layout_gravity="center"
                    />
                <TextView
                    android:id="@+id/nextDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تەواو"
                    android:layout_margin="@dimen/_10sdp"
                    android:background="@drawable/btn_yes_bg3"
                    android:paddingEnd="@dimen/_25sdp"
                    android:paddingStart="@dimen/_25sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:paddingTop="@dimen/_3sdp"
                    android:fontFamily="@font/rabar015"
                    android:textColor="@color/textColorWhite"
                    android:textSize="@dimen/_18sdp"
                    android:textAlignment="center"
                    android:layout_gravity="center"
                    />



            </LinearLayout>
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:max="30"
                android:progress="0"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_10sdp"
                />
            </LinearLayout>

        <LinearLayout
            android:id="@+id/KhatmENDLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:gravity="center"
            android:fontFamily="@font/rabar014"
            android:paddingStart="@dimen/_20sdp"
            android:paddingEnd="@dimen/_20sdp"
            android:paddingTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_5sdp"
            android:background="@drawable/number_back"
            android:elevation="8dp"
            android:layout_margin="@dimen/_24sdp"
            android:visibility="visible"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="خوای گەورە لێتانی قبوڵ بفەرموێت ، ببێت بە تێشوی قیامەتان ."
                android:textColor="@color/textColorBlack"
                android:textSize="@dimen/_16sdp"
                android:paddingEnd="@dimen/_15sdp"
                android:paddingStart="@dimen/_15sdp"
                android:paddingBottom="@dimen/_3sdp"
                android:paddingTop="@dimen/_3sdp"
                android:fontFamily="@font/rabar014"
                android:textAlignment="center"
                android:layout_gravity="center"
                />
            <TextView
                android:id="@+id/btnDuaa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" دوعای خەتمی قورئان "
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/btn_yes_bg3"
                android:paddingEnd="@dimen/_15sdp"
                android:paddingStart="@dimen/_10sdp"
                android:paddingBottom="@dimen/_3sdp"
                android:paddingTop="@dimen/_3sdp"
                android:textColor="@color/textColorWhite"
                android:textSize="@dimen/_18sdp"
                android:textAlignment="center"
                android:fontFamily="@font/rabar014"
                android:layout_gravity="center"
                app:drawableStartCompat="@drawable/dua_hands"
                app:drawableTint="@color/textColorWhite" />
            <TextView
                android:id="@+id/btnNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" خەتمێکی نـــــوێ "
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/btn_yes_bg"
                android:paddingEnd="@dimen/_15sdp"
                android:paddingStart="@dimen/_10sdp"
                android:paddingBottom="@dimen/_3sdp"
                android:paddingTop="@dimen/_3sdp"
                android:textColor="@color/textColorWhite"
                android:textSize="@dimen/_18sdp"
                android:textAlignment="center"
                android:layout_gravity="center"
                app:drawableStartCompat="@drawable/quran_khatm_small"
                app:drawableTint="@color/textColorWhite"
                />

        </LinearLayout>


            <View
                android:layout_width="@dimen/_1sdp"
                android:layout_height="@dimen/_200sdp"/>

        <LinearLayout
            android:id="@+id/HelpNoorLayout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="@dimen/_20sdp"
            android:paddingEnd="@dimen/_20sdp"
            android:paddingTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_5sdp"
            android:background="@drawable/number_back"
            android:elevation="8dp"
            android:layout_margin="@dimen/_24sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="پشتگیری نــــــــور بکە "
                android:textColor="@color/textColorBlack"
                android:fontFamily="@font/rabar015"
                android:textSize="@dimen/_14sdp"
                android:layout_gravity="right"
                android:gravity="right"
                tools:ignore="RtlHardcoded" />
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieAnimationViewDonation"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/donation_icon"
                />

        </LinearLayout>

        </LinearLayout>



    </androidx.core.widget.NestedScrollView>


</LinearLayout>