<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_background">


    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="هەڵبژاردنی ئایەت"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/rabar015"
        android:textColor="@color/textColorRed"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:id="@+id/btnPlayAyah"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="right|center_vertical"
        android:orientation="horizontal"
        android:paddingRight="15dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لێرەوە دەست پێ بکە"
            android:textSize="18sp"
            android:fontFamily="@font/rabar015"
            android:layout_marginRight="15dp"
            android:textColor="#000000" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_play"
            app:tint="@color/black" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.3"
        android:background="@color/black"/>

    <LinearLayout
        android:id="@+id/btnCopyAyah"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="right|center_vertical"
        android:orientation="horizontal"
        android:paddingRight="15dp"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="کۆپیکردنی دەق"
            android:textSize="18sp"
            android:fontFamily="@font/rabar015"
            android:layout_marginRight="15dp"
            android:textColor="#000000"/>

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_copy"
            app:tint="@color/black" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.3"
        android:background="@color/black"/>

    <LinearLayout
        android:id="@+id/btnBookmarkAyah"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="right|center_vertical"
        android:orientation="horizontal"
        android:paddingRight="15dp"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="نیشانەکردن"
            android:textSize="18sp"
            android:fontFamily="@font/rabar015"
            android:layout_marginRight="15dp"
            android:textColor="@color/textColorBlack"/>

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_bookmark"
            app:tint="@color/black" />
    </LinearLayout>

</LinearLayout>