<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <ScrollView
        android:id="@+id/scrollDefaultRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/backgroundColor"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:context=".activities.QuranMP3Activity">

            <LinearLayout
                android:id="@+id/headerBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_back"
                    android:layout_margin="10dp"
                    android:layout_gravity="center"
                    app:tint="@color/colorBrown"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_20sdp"
                    android:text="دەنگی قورئان"
                    android:fontFamily="@font/rabar015"
                    android:textColor="@color/textColorBlack"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center"
                    tools:ignore="HardcodedText" />
                <TextView
                    android:id="@+id/textViewBackground"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="10dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="4dp"
                    android:text="پاشبنەما"
                    android:fontFamily="@font/rabar015"
                    android:textColor="@color/colorBrown"
                    android:textSize="@dimen/_14sdp"
                    tools:ignore="HardcodedText" />

                <ImageView
                    android:id="@+id/btnDownload"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_download"
                    android:layout_margin="10dp"
                    android:layout_gravity="center"
                    tools:ignore="ContentDescription" />
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/vinylContainer"
                android:layout_width="300dp"
                android:layout_height="300dp"
                app:layout_constraintTop_toBottomOf="@id/headerBar"
                app:layout_constraintBottom_toTopOf="@id/linearLayout3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_bias="0.5">

                <ImageView
                    android:id="@+id/imgVinylDisc"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_vinyl_disc"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgCenterArtwork"
                    android:layout_width="125dp"
                    android:layout_height="125dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/media_player_image_bg"
                    app:shapeAppearanceOverlay="@style/CircleImageView"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

                <ImageView
                    android:id="@+id/imgVinylNeedle"
                    android:layout_width="80dp"
                    android:layout_height="160dp"
                    android:elevation="4dp"
                    android:src="@drawable/ic_vinyl_needle"
                    android:transformPivotX="30dp"
                    android:transformPivotY="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/linearLayout3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/vinylContainer"
                app:layout_constraintBottom_toTopOf="@id/linearLayout2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/textViewSuraName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/hafs_bold"
                    android:gravity="start"
                    android:background="?android:attr/selectableItemBackground"
                    android:drawableLeft="@drawable/caret_down"
                    android:drawablePadding="5dp"
                    android:drawableTint="@color/colorBrown"
                    android:text="سُورَةُ الفَاتِحَةِ"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/_18sdp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/textViewQariName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:fontFamily="@font/rabar015"
                    android:drawableLeft="@drawable/caret_down"
                    android:drawablePadding="5dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:drawableTint="@color/colorBrown"
                    android:gravity="end"
                    android:text="توفيق بن سعيد الصايغ"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/_18sdp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/textViewDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:fontFamily="@font/rabar015"
                    android:gravity="end"
                    android:text="00:00 - 00:00"
                    android:textColor="@color/textColorLightBrown"
                    android:textSize="@dimen/_14sdp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.dya.noor.customImageView.WaveSeekBar
                    android:id="@+id/waveSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginStart="16dp"
                    app:waveBackgroundColor="@color/colorLightBrown"
                    app:waveProgressColor="@color/greenDarkColor"
                    app:waveBarWidth="7dp"
                    app:waveBarGap="10dp"
                    app:waveCornerRadius="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnRewind"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_margin="10dp"
                        app:tint="@color/mediaPlayIconColor"
                        android:src="@drawable/step_rewind_dng"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/shape_rounded_lozenge"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:id="@+id/btnPlay"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            app:tint="@color/white"
                            android:src="@drawable/play_dng"
                            tools:ignore="ContentDescription" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnForward"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_margin="10dp"
                        android:src="@drawable/step_forward_dng"
                        app:tint="@color/mediaPlayIconColor"
                        tools:ignore="ContentDescription" />
                </LinearLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


    <FrameLayout
        android:id="@+id/ambienceOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        >

        <TextureView
            android:id="@+id/videoBackgroundView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000" />

        <ImageView
            android:id="@+id/btnBackAmbience"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_back"
            app:tint="@color/white"
            android:padding="5dp"
            android:background="@drawable/glass_background"
            tools:ignore="ContentDescription" />
        <TextView
            android:id="@+id/textViewChangeBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="16dp"
            android:text="پاشبنەما"
            android:paddingEnd="15dp"
            android:paddingStart="15dp"
            android:textColor="@color/white"
            android:background="@drawable/glass_background"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/textViewSuraNameAmbience"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hafs_bold"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="سُورَةُ الفَاتِحَةِ" />

            <TextView
                android:id="@+id/textViewQariNameAmbience"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="#CCFFFFFF"
                android:textSize="15sp"
                tools:text="أبو بکر الشاطري" />

            <SeekBar
                android:id="@+id/seekBarAmbience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="@color/white"
                android:thumbTint="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textViewCurrentTimeAmbience"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="00:00"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/textViewRemainingTimeAmbience"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-00:00"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnRewindAmbience"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_margin="14dp"
                    android:src="@drawable/step_rewind_dng"
                    app:tint="@color/white"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/btnPlayAmbience"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/play_dng"
                    app:tint="@color/white"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/btnForwardAmbience"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_margin="14dp"
                    android:src="@drawable/step_forward_dng"
                    app:tint="@color/white"
                    tools:ignore="ContentDescription" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>