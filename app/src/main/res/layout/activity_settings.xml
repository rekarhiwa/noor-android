<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backgrund_image"
    android:id="@+id/linearLayout"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".activities.AppSettings">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/sBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck" />


        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:textColor="@color/textColorBlack"
            android:fontFamily="@font/rabar015"
            android:text="ڕێکخستن"
            android:textAlignment="center"
            android:textSize="25sp"
            tools:ignore="HardcodedText" />

    </LinearLayout>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="10dp">
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/DangLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:textColor="@color/textColorBlack"
                android:fontFamily="@font/rabar015"
                android:text="دەنگی بانگ بێژ"
                android:layout_gravity="end"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:elevation="5dp"
                        android:padding="5dp"
                        android:layout_gravity="center"
                        app:cardBackgroundColor="@color/backgroundColor"
                        app:cardCornerRadius="14dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:gravity="center">
                            <ImageButton
                                android:id="@+id/btntvB"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"

                                android:background="@drawable/ic_play"
                                android:elevation="3dp"
                                tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck,ImageContrastCheck" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>


                    <TextView
                        android:id="@+id/tvB"
                        android:background="@drawable/backgrownd_btn_taf"
                        android:elevation="5dp"
                        android:padding="8dp"
                        android:layout_margin="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:outlineAmbientShadowColor="@color/black"
                        android:outlineSpotShadowColor="@color/colorOrang"
                        android:fontFamily="@font/rabar014"
                        android:textColor="@color/textColorBlack"
                        android:text="شێخ ناصر القطامی ( بانگی کورت )"
                        android:textAlignment="textStart"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText"
                        tools:targetApi="p" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:elevation="5dp"
                        android:padding="5dp"
                        android:layout_gravity="center"
                        app:cardBackgroundColor="@color/backgroundColor"
                        app:cardCornerRadius="14dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:gravity="center">
                            <ImageButton
                                android:id="@+id/btntvE"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/ic_play"
                                android:elevation="3dp"
                                tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck,ImageContrastCheck" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tvE"
                        android:background="@drawable/backgrownd_btn_taf"
                        android:elevation="5dp"
                        android:padding="8dp"
                        android:layout_margin="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:outlineAmbientShadowColor="@color/black"
                        android:outlineSpotShadowColor="@color/colorOrang"
                        android:fontFamily="@font/rabar014"
                        android:text="شێخ ناصر القطامی ( بانگی تەواو )"
                        android:textColor="@color/textColorBlack"
                        android:textAlignment="textStart"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText"
                        tools:targetApi="p" />


                </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <androidx.cardview.widget.CardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:elevation="5dp"
                    android:padding="5dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="@color/backgroundColor"
                    app:cardCornerRadius="14dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center">
                        <ImageButton
                            android:id="@+id/btntvhijaz"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@drawable/ic_play"
                            android:elevation="3dp"
                            tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck,ImageContrastCheck" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tvhijaz"
                        android:background="@drawable/backgrownd_btn_taf"
                        android:elevation="5dp"
                        android:padding="8dp"
                        android:layout_margin="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:outlineAmbientShadowColor="@color/black"
                        android:outlineSpotShadowColor="@color/colorOrang"
                        android:fontFamily="@font/rabar014"
                        android:text="بانگی حیجاز"
                        android:textColor="@color/textColorBlack"
                        android:textAlignment="textStart"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText"
                        tools:targetApi="p" />

                </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <androidx.cardview.widget.CardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:elevation="5dp"
                    android:padding="5dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="@color/backgroundColor"
                    app:cardCornerRadius="14dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center">
                        <ImageButton
                            android:id="@+id/btntvrad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@drawable/ic_play"
                            android:elevation="3dp"
                            tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck,ImageContrastCheck" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                    <TextView
                        android:id="@+id/tvrad"
                        android:background="@drawable/backgrownd_btn_taf"
                        android:elevation="5dp"
                        android:padding="8dp"
                        android:layout_margin="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:outlineAmbientShadowColor="@color/black"
                        android:outlineSpotShadowColor="@color/colorOrang"
                        android:fontFamily="@font/rabar014"
                        android:text="رعد محمد"
                        android:textColor="@color/textColorBlack"
                        android:textAlignment="textStart"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText"
                        tools:targetApi="p" />

                </LinearLayout>


            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <androidx.cardview.widget.CardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:elevation="5dp"
                    android:padding="5dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="@color/backgroundColor"
                    app:cardCornerRadius="14dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center">
                        <ImageButton
                            android:id="@+id/btntvpeshewa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@drawable/ic_play"
                            android:elevation="3dp"
                            tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck,ImageContrastCheck" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                    <TextView
                        android:id="@+id/tvpeshewa"
                        android:background="@drawable/backgrownd_btn_taf"
                        android:elevation="5dp"
                        android:padding="8dp"
                        android:layout_margin="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:outlineAmbientShadowColor="@color/black"
                        android:outlineSpotShadowColor="@color/colorOrang"
                        android:fontFamily="@font/rabar014"
                        android:text="پێشەوا قادر"
                        android:textColor="@color/textColorBlack"
                        android:textAlignment="textStart"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText"
                        tools:targetApi="p" />

                </LinearLayout>


            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <androidx.cardview.widget.CardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:elevation="5dp"
                    android:padding="5dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="@color/backgroundColor"
                    app:cardCornerRadius="14dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center">
                        <ImageButton
                            android:id="@+id/btntvbast"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@drawable/ic_play"
                            android:elevation="3dp"
                            tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck,ImageContrastCheck" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tvbast"
                        android:background="@drawable/backgrownd_btn_taf"
                        android:elevation="5dp"
                        android:padding="8dp"
                        android:layout_margin="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:outlineAmbientShadowColor="@color/black"
                        android:outlineSpotShadowColor="@color/colorOrang"
                        android:fontFamily="@font/rabar014"
                        android:text="عبد الباصت عبد الصمد"
                        android:textColor="@color/textColorBlack"
                        android:textAlignment="textStart"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText"
                        tools:targetApi="p" />

                </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <androidx.cardview.widget.CardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:elevation="5dp"
                    android:padding="5dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="@color/backgroundColor"
                    app:cardCornerRadius="14dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center">
                        <ImageButton
                            android:id="@+id/btntvislam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@drawable/ic_play"
                            android:elevation="3dp"
                            tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck,ImageContrastCheck" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tvislam"
                        android:background="@drawable/backgrownd_btn_taf"
                        android:elevation="5dp"
                        android:padding="8dp"
                        android:layout_margin="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:outlineAmbientShadowColor="@color/black"
                        android:outlineSpotShadowColor="@color/colorOrang"
                        android:fontFamily="@font/rabar014"
                        android:text="اسلام صبحی"
                        android:textColor="@color/textColorBlack"
                        android:textAlignment="textStart"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText"
                        tools:targetApi="p" />

                </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/PirmessionLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:alpha="0.6"
                android:textColor="@color/textColorBlack"
                android:fontFamily="@font/rabar015"
                android:text="پێدانی دەسەڵات"
                android:layout_gravity="end"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvActicShasha"
                    android:background="@drawable/btn_no_bg"
                    android:elevation="5dp"
                    android:padding="8dp"
                    android:layout_margin="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textColorWhite"
                    android:outlineAmbientShadowColor="@color/black"
                    android:outlineSpotShadowColor="@color/colorOrang"
                    android:fontFamily="@font/rabar014"
                    android:text="پیشاندانی بانگ لەسەر شاشە"
                    android:textAlignment="textStart"
                    android:textSize="18sp"
                    tools:ignore="HardcodedText"
                    tools:targetApi="p"
                    app:drawableStartCompat="@drawable/phone"
                    />


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvActiveBattery"
                    android:background="@drawable/btn_no_bg"
                    android:elevation="5dp"
                    android:padding="8dp"
                    android:layout_margin="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textColorWhite"
                    android:outlineAmbientShadowColor="@color/black"
                    android:outlineSpotShadowColor="@color/colorOrang"
                    android:fontFamily="@font/rabar014"
                    android:text="پشتگوێخستنی پاتری"
                    android:textAlignment="textStart"
                    app:drawableStartCompat="@drawable/optimising_battery"
                    android:textSize="18sp"
                    tools:ignore="HardcodedText"
                    tools:targetApi="p" />


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvActicNotfi"
                    android:background="@drawable/btn_no_bg"
                    android:elevation="5dp"
                    android:padding="8dp"
                    android:layout_margin="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textColorWhite"
                    app:drawableStartCompat="@drawable/notifications_active"
                    android:outlineAmbientShadowColor="@color/black"
                    android:outlineSpotShadowColor="@color/colorOrang"
                    android:fontFamily="@font/rabar014"
                    android:text="ناردنی ئاگانامە"
                    android:textAlignment="textStart"
                    android:textSize="18sp"
                    tools:ignore="HardcodedText"
                    tools:targetApi="p" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvAlarm"
                    android:background="@drawable/btn_no_bg"
                    android:elevation="5dp"
                    android:padding="8dp"
                    android:layout_margin="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textColorWhite"
                    app:drawableStartCompat="@drawable/alarm_clock"
                    android:outlineAmbientShadowColor="@color/black"
                    android:outlineSpotShadowColor="@color/colorOrang"
                    android:fontFamily="@font/rabar014"
                    android:text="ناردنی ئاگاداری لەکاتی خۆی"
                    android:textAlignment="textStart"
                    android:textSize="18sp"
                    tools:ignore="HardcodedText"
                    tools:targetApi="p" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:textColor="@color/textColorBlack"
                    android:fontFamily="@font/rabar015"
                    android:text="دواکەوتنی بانگ لە مۆبایلە چینیەکان"
                    android:layout_gravity="end"
                    android:alpha="0.6"
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvChina"
                    android:background="@drawable/btn_yes_bg3"
                    android:elevation="5dp"
                    android:padding="8dp"
                    android:layout_margin="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textColorWhite"
                    app:drawableStartCompat="@drawable/settings"
                    android:drawableTint="@color/white"
                    android:outlineAmbientShadowColor="@color/black"
                    android:outlineSpotShadowColor="@color/colorOrang"
                    android:fontFamily="@font/rabar014"
                    android:text="چون بۆ سێتینگی مۆبایلەکە"
                    android:textAlignment="textStart"
                    android:textSize="18sp"
                    tools:ignore="HardcodedText"
                    tools:targetApi="p" />

                <TextView
                    android:id="@+id/tvHuawei"
                    android:background="@drawable/btn_yes_bg2"
                    android:elevation="5dp"
                    android:padding="8dp"
                    android:layout_margin="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textColorWhite"
                    app:drawableStartCompat="@drawable/screen_play"
                    android:drawableTint="@color/white"
                    android:outlineAmbientShadowColor="@color/black"
                    android:outlineSpotShadowColor="@color/colorOrang"
                    android:fontFamily="@font/rabar014"
                    android:text="فێرکاری بۆ مۆبایلەکانی Huawei و Honor"
                    android:textAlignment="textStart"
                    android:textSize="18sp"
                    tools:ignore="HardcodedText"
                    tools:targetApi="p" />


            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/textSizLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:alpha="0.6"
                android:textColor="@color/textColorBlack"
                android:fontFamily="@font/rabar015"
                android:text="قەبارەی نوسین"
                android:layout_gravity="end"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:id="@+id/quranSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/backgrownd_btn_taf"
                android:elevation="5dp"
                android:padding="8dp"
                android:layout_margin="10dp"
                android:outlineAmbientShadowColor="@color/black"
                android:outlineSpotShadowColor="@color/colorOrang"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:id="@+id/btnQuranSizeMinus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textColorBlack"
                    android:fontFamily="@font/rabar015"
                    android:text="-"
                    android:background="@drawable/backgrownd_btn_taf"
                    android:layout_margin="5dp"
                    android:textAlignment="textStart"
                    android:textSize="20sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:elevation="2dp"
                    tools:ignore="HardcodedText"
                    tools:targetApi="p" />
                <TextView
                    android:id="@+id/txtQuranSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textColorBlack"
                    android:fontFamily="@font/rabar014"
                    android:text="27"
