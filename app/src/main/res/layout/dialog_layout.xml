<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_close"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="@dimen/_10sdp"
    app:cardElevation="@dimen/_20sdp"
    android:padding="@dimen/_10sdp"
    app:cardBackgroundColor="@color/backgroundColor"
    xmlns:app="http://schemas.android.com/apk/res-auto">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_margin="@dimen/_10sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieAnimationView"
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:layout_gravity="center"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/warning_status" />


                <TextView
                    android:id="@+id/suratTx"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAlignment="center"
                    android:layout_gravity="center"
                    android:fontFamily="@font/rabar015"
                    android:text="ئاگەداربە!"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/_22sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/IconV"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="HardcodedText" />

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/IconV"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_nbb"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />



            </LinearLayout>


            <TextView
                android:id="@+id/TxtQ"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:fontFamily="@font/rabar015"
                android:text="بەکارهێنەری بەڕیز ، تکایە ئاگەداربە\n لەکاتی چون بۆ سەرئاو مۆبایلەکەت لەگەڵ خۆتدامەبە ، بەتایبەت ئەوکاتانەی نزیکە لەبانگدان ، چونکە مۆبایلەکەت بانگ دەدات ، ئەمەش دروست نییە لەو شوێنەدا ، جزاك الله. "
                android:textColor="@color/textColorBlack"
                android:textSize="@dimen/_18sdp"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btnSetting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_25sdp"
                android:elevation="30dp"
                android:background="@drawable/btn_yes_bg2"
                android:fontFamily="@font/rabar014"
                android:text="باشە"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/_15sdp"
                android:textStyle="bold"
                android:outlineSpotShadowColor="@color/colorOrang"
                android:outlineAmbientShadowColor="@color/colorPrimary"
                 tools:ignore="HardcodedText,TextContrastCheck,TouchTargetSizeCheck" />

        </LinearLayout>

</androidx.cardview.widget.CardView>