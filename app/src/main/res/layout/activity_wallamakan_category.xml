<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/WalamakanMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.WallamakanCategory"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@drawable/backgrund_image"
    >

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_collapseMode="parallax"
        android:background="@color/colorPrimary"
        app:contentInsetStartWithNavigation="0dp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            >
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_back"
                app:tint="@color/backgroundColor"
                tools:ignore="ContentDescription"
                android:layout_gravity="center"
                />
            <TextView
                android:id="@+id/txtNamesTop"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:fontFamily="@font/rabar015"
                android:layout_height="wrap_content"
                android:text="وەڵامەکان"
                android:layout_gravity="center"
                android:textColor="@color/textColorWhite"
                android:gravity="center"
                android:textSize="@dimen/_20sdp"
                />




        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/wallamakanCategoryRecyclerView"/>

</LinearLayout>