<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardViewPlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:backgroundTint="@color/colorOrang"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        tools:ignore="UseCompoundDrawables">

        <!-- TEXT - LEFT -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:fontFamily="@font/rabar015"
            android:gravity="start"
            android:text="ژیان نامەی پێغمبەرﷺ"
            android:textColor="@color/textColorWhite"
            android:textSize="@dimen/_12sdp"
            android:maxLines="2"
            android:ellipsize="end"
            tools:ignore="HardcodedText,TextSizeCheck,TextContrastCheck" />

        <!-- IMAGE - RIGHT -->
        <ImageView
            android:id="@+id/ivImageResource"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/muhammad"
            tools:ignore="ContentDescription,ImageContrastCheck" />



    </LinearLayout>

</androidx.cardview.widget.CardView>