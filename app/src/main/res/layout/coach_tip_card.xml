<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/coach_tip_bg"
    android:elevation="10dp"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/coachTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/rabar015"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/textColorBlack"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="سەردێڕ" />

    <TextView
        android:id="@+id/coachBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/rabar014"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:maxHeight="120dp"
        android:scrollbars="vertical"
        android:textColor="@color/second_text_color"
        android:textSize="13sp"
        tools:text="ڕوونکردنەوە" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/coachSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rabar015"
            android:padding="8dp"
            android:text="تێپەڕین"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/coachNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/coach_next_btn"
            android:fontFamily="@font/rabar015"
            android:minWidth="96dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="دواتر"
            android:textColor="@color/textColorWhite"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</LinearLayout>
