<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@drawable/backgrund_image"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".activities.AyatKursyActivity">



    <LinearLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:orientation="horizontal">


        <ImageButton
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/ic_back"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rabar015"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ئایەتی کورسی"
            android:textColor="@color/colorPrimary"
            android:textSize="25sp"
            tools:ignore="HardcodedText" />


    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="10dp">


            <androidx.cardview.widget.CardView
                android:id="@+id/cardViewPlay3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/backgroundColor"
                app:cardCornerRadius="15dp"
                app:cardElevation="8dp"
                android:outlineSpotShadowColor="@color/black"
                android:outlineAmbientShadowColor="@color/black"
                tools:targetApi="p">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btnAyaPlay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_margin="10dp"
                            android:src="@drawable/ic_play"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/txtCurrent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textColor="@color/textColorBlack"
                            android:fontFamily="@font/rabar015"
                            android:text="00:00"/>


                        <SeekBar
                            android:id="@+id/seekBar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            />

                        <TextView
                            android:id="@+id/txtTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textColor="@color/textColorBlack"
                            android:fontFamily="@font/rabar015"
                            android:text="00:00"/>

                    </LinearLayout>



            </androidx.cardview.widget.CardView>



            <TextView
                android:id="@+id/txtAya"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:justificationMode="inter_word"
                android:fontFamily="@font/uthmanic_hafs1b_ver13"
                android:text="@string/AyaAlkwrsy"
                android:textAlignment="center"
                android:textColor="@color/textColorBlack"
                android:textSize="25sp" />





            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="5dp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/rabar015"
                android:text="تەفسیری ئایەتەکە"
                android:alpha="0.5"
                android:textAlignment="center"
                android:textColor="@color/textColorBlack"
                android:textSize="16sp" />



            <TextView
                android:id="@+id/txtMana"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/rabar015"
                android:text="@string/manayAyaAlkwrsy"
                android:textAlignment="center"
                android:justificationMode="inter_word"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:textColor="@color/textColorBlack"
                android:textSize="18sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="5dp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/rabar015"
                android:text="سودەکانی ئایەتەکە"
                android:alpha="0.5"
                android:textAlignment="center"
                android:textColor="@color/textColorBlack"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtSud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/rabar015"
                android:text="@string/sudAyaAlkwrsy"
                android:textAlignment="textStart"
                android:justificationMode="inter_word"
                android:textColor="@color/textColorBlack"
                android:textSize="18sp"
                />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>



</LinearLayout>