<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/backgrund_image"
    tools:context=".activities.ActivityHajUmrah">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="10dp">
        <ImageButton
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/ic_back"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck" />
        <ImageButton
            android:id="@+id/back2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:background="@drawable/ic_back"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/tv2"
            android:elevation="5dp"
            android:padding="8dp"
            android:layout_margin="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_gravity="center"
            android:gravity="center"
            android:fontFamily="@font/rabar014"
            android:text="حەج و عومرە"
            android:textColor="@color/textColorBlack"
            android:textSize="20sp"
            tools:ignore="HardcodedText" />
        <TextView
            android:id="@+id/tv3"
            android:elevation="5dp"
            android:padding="8dp"
            android:layout_margin="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:fontFamily="@font/rabar014"
            android:text="حەج و عومرە"
            android:visibility="gone"
            android:justificationMode="inter_word"
            android:textColor="@color/textColorBlack"
            android:textSize="20sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>




<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="10dp">

        <LinearLayout
            android:id="@+id/layout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="10dp">


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@color/cardBackgroundColor"
                app:cardCornerRadius="5dp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/t1"
                        android:elevation="5dp"
                        android:padding="8dp"
                        android:layout_margin="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="textStart"
                        android:fontFamily="@font/rabar014"
                        android:outlineAmbientShadowColor="@color/black"
                        android:outlineSpotShadowColor="@color/colorOrang"
                        android:text="@string/sunatakany_safar_krdn"
                        android:textColor="@color/textColorBlack"
                        android:textSize="16sp"
                        tools:targetApi="p" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@color/cardBackgroundColor"
                app:cardCornerRadius="5dp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/t2"
                        android:elevation="5dp"
                        android:padding="8dp"
                        android:layout_margin="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="textStart"
                        android:outlineAmbientShadowColor="@color/black"
                        android:outlineSpotShadowColor="@color/colorOrang"
                        android:fontFamily="@font/rabar014"
                        android:text="@string/hukma_kany_haj_w_umra"
                        android:textColor="@color/textColorBlack"
                        android:textSize="16sp"
                        tools:targetApi="p" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@color/cardBackgroundColor"
                app:cardCornerRadius="5dp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/t3"
                        android:elevation="5dp"
                        android:padding="8dp"
                        android:layout_margin="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:outlineAmbientShadowColor="@color/black"
                        android:outlineSpotShadowColor="@color/colorOrang"
                        android:textAlignment="textStart"
                        android:fontFamily="@font/rabar014"
                        android:text="@string/karakany_haj_w_umra"
                        android:textColor="@color/textColorBlack"
                        android:textSize="16sp"
                        tools:targetApi="p" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>




            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@color/cardBackgroundColor"
                app:cardCornerRadius="5dp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/t4"
                        android:elevation="5dp"
                        android:padding="8dp"
                        android:layout_margin="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:outlineAmbientShadowColor="@color/black"
                        android:outlineSpotShadowColor="@color/colorOrang"
                        android:textAlignment="textStart"
                        android:fontFamily="@font/rabar014"
                        android:text="@string/ark_w_rwknakany_haj"
                        android:textColor="@color/textColorBlack"
                        android:textSize="16sp"
                        tools:targetApi="p" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@color/cardBackgroundColor"
                app:cardCornerRadius="5dp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/t5"
                        android:elevation="5dp"
                        android:padding="8dp"
                        android:layout_margin="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:outlineAmbientShadowColor="@color/black"
                        android:outlineSpotShadowColor="@color/colorOrang"
                        android:textAlignment="textStart"
                        android:fontFamily="@font/rabar014"
                        android:text="@string/anjamdany_umrah"
                        android:textColor="@color/textColorBlack"
                        android:textSize="16sp"
                        tools:targetApi="p" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@color/cardBackgroundColor"
                app:cardCornerRadius="5dp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/t6"
                        android:elevation="5dp"
                        android:padding="8dp"
                        android:layout_margin="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="textStart"
                        android:outlineAmbientShadowColor="@color/black"
                        android:outlineSpotShadowColor="@color/colorOrang"
                        android:fontFamily="@font/rabar014"
                        android:text="@string/zyaraty_madyna"
                        android:textColor="@color/textColorBlack"
                        android:textSize="16sp"
                        tools:targetApi="p" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>


        <TextView
            android:id="@+id/tv"
            android:elevation="5dp"
            android:padding="8dp"
            android:layout_margin="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="textStart"
            android:fontFamily="@font/rabar014"
            android:text="تێست"
            android:visibility="gone"
            android:textColor="@color/textColorBlack"
            android:textSize="16sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

</androidx.core.widget.NestedScrollView>



</LinearLayout>