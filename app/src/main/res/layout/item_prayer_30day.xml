<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="18dp"
                android:layout_marginBottom="3dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAlignment="center"
                android:background="@color/xawtnanColor"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:padding="5dp"
                    android:text="خەوتنان"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:fontFamily="@font/rabar014"
                    android:id="@+id/txtEsha"/>
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="16dp"
                android:layout_marginBottom="3dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/ewaraColor"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:padding="5dp"
                    android:textAlignment="center"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:fontFamily="@font/rabar014"
                    android:id="@+id/txtEywra"/>
            </LinearLayout>


            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="16dp"
                android:layout_marginBottom="3dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/asrColor"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:padding="5dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:fontFamily="@font/rabar014"
                    android:id="@+id/txtAsr"/>
            </LinearLayout>


            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="16dp"
                android:layout_marginBottom="3dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/newaroColor"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:padding="5dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:fontFamily="@font/rabar014"
                    android:id="@+id/txtNiwaro"/>
            </LinearLayout>







            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="16dp"
                android:layout_marginBottom="3dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/bayanyColor"
                >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:padding="5dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:fontFamily="@font/rabar014"
                    android:id="@+id/txtBayani"
                    />

            </LinearLayout>



            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@color/barwarColor"
                >
                <TextView
                    android:id="@+id/txtDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textAlignment="center"
                    android:gravity="center"
                    android:padding="5dp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/rabar014"/>
            </LinearLayout>



        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
