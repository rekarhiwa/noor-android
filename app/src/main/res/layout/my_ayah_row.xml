<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:id="@+id/ayaLayout">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewPlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/cardBackgroundColor">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="8dp"
            android:gravity="end"
            android:layout_gravity="end">

            <!-- Ayah Header -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                android:padding="5dp"
                android:layout_margin="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ayanum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1:7"
                        android:layout_gravity="center"
                        android:textSize="18sp"
                        android:textColor="@color/textColorBlack"
                        android:fontFamily="@font/rabar015"
                        android:layout_marginStart="15dp" />
                    <TextView
                        android:id="@+id/juz_page"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="پەڕەی 1 | جزء1"
                        android:textSize="11sp"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textColor="@color/textColorBlack"
                        android:fontFamily="@font/rabar015"
                        android:layout_marginStart="15dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end">

                        <ImageButton
                            android:id="@+id/btnCopy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_gravity="center"
                            android:background="@drawable/ic_copy"
                            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

                        <ImageButton
                            android:id="@+id/btnSave"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_gravity="center"
                            android:background="@drawable/ic_bookmark"
                            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quran Text -->
            <TextView
                android:id="@+id/qurann"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ"
                android:textSize="27sp"
                android:textColor="@color/textColorBlack"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="3dp"
                android:justificationMode="inter_word"
                android:layout_marginEnd="3dp"
                android:fontFamily="@font/uthmanic_hafs1b_ver13" />

            <!-- Kurdish Tafseer -->
            <TextView
                android:id="@+id/krd2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ئیملایی کوردی"
                android:textSize="14sp"
                android:textColor="@color/black2"
                android:layout_margin="3dp"
                android:fontFamily="@font/rabar014" />

            <TextView
                android:id="@+id/krd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تەفسیر"
                android:textSize="22sp"
                android:justificationMode="inter_word"
                android:textColor="@color/black2"
                android:layout_margin="3dp"
                android:fontFamily="@font/rabar014" />

            <TextView
                android:id="@+id/amazha_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="زمانی ئاماژە"
                android:textSize="14sp"
                android:textColor="@color/black2"
                android:layout_margin="3dp"
                android:fontFamily="@font/rabar014" />

            <TextView
                android:id="@+id/amazha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="بسم الله الرحمن الرحيم"
                android:textSize="22sp"
                android:textColor="@color/black2"
                android:layout_margin="3dp"
                android:fontFamily="@font/amazha_font" />

            <!-- Single TextView for all Tafseer -->
            <TextView
                android:id="@+id/allTafseer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/textColorBlack"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:lineSpacingExtra="4dp"
                android:justificationMode="inter_word"
                android:visibility="gone"
                android:fontFamily="@font/rabar014" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>