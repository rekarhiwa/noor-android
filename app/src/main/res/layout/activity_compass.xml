<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/qibla_background"
    android:fitsSystemWindows="true"
    tools:context=".activities.CompassActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">


        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="70dp">

            <ImageView
                android:id="@+id/back"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_qibla_icon_button"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="11dp"
                android:src="@drawable/ic_back_qibla"
                tools:ignore="TouchTargetSizeCheck" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Qibla Compass"
                    android:textColor="@color/qibla_dark"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/rabar015" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="بەرەو قیبڵە"
                    android:textColor="@color/qibla_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/rabar014" />

            </LinearLayout>

        </RelativeLayout>


        <!-- Small instruction -->
        <TextView
            android:id="@+id/tvCompassInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="بەرەو ئاراستەی قیبڵە بڕۆ"
            android:textColor="@color/qibla_secondary"
            android:textSize="15sp"
            android:fontFamily="@font/rabar014"
            android:gravity="center" />


        <!-- Compass -->
        <FrameLayout
            android:id="@+id/compassContainer"
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:layout_marginTop="12dp"
            android:gravity="center">

            <!-- soft circle behind compass -->
            <View
                android:layout_width="290dp"
                android:layout_height="290dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_compass_circle" />

            <!-- Existing compass dial -->
            <ImageView
                android:id="@+id/dial"
                android:layout_width="270dp"
                android:layout_height="270dp"
                android:layout_gravity="center"
                android:layout_centerInParent="true"
                android:contentDescription="Compass Dial"
                android:src="@drawable/compass_dail"
                android:scaleType="fitCenter"
                tools:ignore="HardcodedText,ObsoleteLayoutParam" />

            <!-- Existing Qibla indicator -->
            <ImageView
                android:id="@+id/qibla_indicator"
                android:layout_width="285dp"
                android:layout_height="285dp"
                android:layout_gravity="center"
                android:contentDescription="Qibla Direction"
                android:src="@drawable/compass_qibla"
                android:scaleType="fitCenter"
                android:visibility="gone" />

        </FrameLayout>


        <!-- Qibla angle card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="5dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_qibla_card">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="27dp"
                    android:contentDescription="@null"
                    android:src="@drawable/cardinal_compass"
                    app:tint="@color/qibla_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="گۆشەی قیبڵە"
                    android:textColor="@color/qibla_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/rabar014" />

                <TextView
                    android:id="@+id/QiblaAngle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="118.7°"
                    android:textColor="@color/qibla_dark"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/rabar015" />

            </LinearLayout>


            <!-- Direction card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_qibla_card">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/qibla_location_"
                    android:contentDescription="@null"
                    app:tint="@color/qibla_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="بەرەو قیبڵە"
                    android:textColor="@color/qibla_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/rabar014" />

                <TextView
                    android:id="@+id/tvQiblaDirection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Qibla"
                    android:textColor="@color/qibla_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/rabar015" />

            </LinearLayout>

        </LinearLayout>


        <!-- Location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_qibla_card">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_location_qibla"
                android:contentDescription="@null"
                app:tint="@color/qibla_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="13dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="شوێنی تۆ"
                    android:textColor="@color/qibla_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/rabar014" />

                <TextView
                    android:id="@+id/your_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="شوێن دیاری نەکراوە"
                    android:textColor="@color/qibla_dark"
                    android:textSize="14sp"
                    android:fontFamily="@font/rabar014"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/qibla_secondary"
                android:textSize="30sp"
                tools:ignore="HardcodedText" />

        </LinearLayout>


        <!-- Bottom explanation -->
        <TextView
            android:id="@+id/tvQiblaHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="مۆبایلەکەت بە شێوەیەکی ڕاست بگرە بۆ دیاریکردنی ئاراستەی قیبڵە"
            android:textColor="@color/qibla_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/rabar014"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

</ScrollView>