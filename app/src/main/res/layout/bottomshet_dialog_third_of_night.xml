<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/sheet_Third"
    android:orientation="vertical"
    android:background="@drawable/bottomshet_back"
    >

    <View
        android:layout_width="50dp"
        android:layout_height="5dp"
        android:background="@drawable/view_background"
        android:layout_marginTop="10dp"
        android:layout_gravity="center|top" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvThirdOfNight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/rabar015"
                android:text="سێیەکی شەو"
                android:layout_gravity="center|top"
                android:textColor="@color/textColorBlack"
                android:textSize="20sp"
                tools:ignore="HardcodedText,TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/tvThirdOfNightHadith"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/rabar015"
                android:text="ئەو فەرمودانەی لەسەر سێیەکی شەو هاتووەن"
                android:layout_gravity="center"
                android:textColor="@color/textColorBlack"
                android:textSize="16sp"
                android:backgroundTint="@color/white"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:clickable="true"
                android:elevation="5dp"
                android:background="@drawable/backgrownd_mediaplay"
                app:drawableLeftCompat="@drawable/angle_small_left"
                tools:ignore="HardcodedText,TouchTargetSizeCheck" />


            <Switch
                android:id="@+id/switchSendNotifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/rabar015"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="30dp"
                android:text="ناردنی ئاگانامە"
                android:textColor="@color/textColorBlack"
                tools:ignore="TouchTargetSizeCheck,UseSwitchCompatOrMaterialXml" />

        </LinearLayout>
    </ScrollView>




    </LinearLayout>


