<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/navigation_drawer"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:background="@color/backgroundColor"
    tools:context=".activities.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:orientation="horizontal"
        tools:ignore="UselessParent">

        <LinearLayout
            android:id="@+id/donationLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:outlineAmbientShadowColor="@color/orangeColor"
            android:outlineSpotShadowColor="@color/orangeColor"
            android:elevation="5dp"
            android:background="@drawable/backgrownd_mediaplay"
            android:backgroundTint="@color/orangeColor"
            android:orientation="horizontal"
            tools:targetApi="28">


            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="5dp"
                android:src="@drawable/hand_holding_heart"
                app:tint="@color/white"
                />

        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="نور قورئانی پیرۆز"
            android:textColor="@color/textColorBlack"
            android:fontFamily="@font/rabar015"
            android:textSize="18sp"
            android:layout_marginEnd="5dp"
            android:layout_gravity="center"
            android:layout_weight="1"
            tools:ignore="InefficientWeight" />

        <ImageView
            android:id="@+id/btnNav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/menu_burger"
            tools:ignore="ContentDescription" />

        <Button
            android:id="@+id/btnSaveAllIcons"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:text="Save"
            android:visibility="gone"
            android:textColor="@color/black"
            android:layout_margin="16dp"
            tools:ignore="HardcodedText" />

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/btnSuratFb"
            android:layout_width="35dp"
            android:layout_height="35dp"
            app:riv_corner_radius="50dp"
            android:visibility="gone"
            android:layout_gravity="end|center"
            android:src="@mipmap/ic_launcher" />


    </LinearLayout>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView2"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

<!-- to find dp in sdp your dp siz * 0.769 like 20dp * 0.769 = 15.38 sdp-->

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/me_quran"
                    android:gravity="end"
                    android:text="اللَّهُمَّ صَلَّ عَلىَ مُحَمَّدٍ وَعَلىَ آلَ مُحَمَّد"
                    android:textAlignment="textEnd"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/_15sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView8"
                    tools:ignore="HardcodedText" />



                <androidx.cardview.widget.CardView
                    android:id="@+id/cardviewTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill"
                    app:cardCornerRadius="10dp"
                    android:layout_margin="8dp"
                    app:cardElevation="8dp">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/homeSlider"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:overScrollMode="never" />



                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:id="@+id/sliderDots"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />




                <LinearLayout
                    android:id="@+id/linearLayoutGotoSeeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone"
                    android:background="@drawable/btn_no_bg">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_settings"
                        android:layout_margin="8dp"
                        app:tint="@color/white"
                        tools:ignore="ContentDescription" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="@font/rabar015"
                        android:layout_margin="8dp"
                        android:text="دەستەڵاتەکان کارانەکراون"
                        tools:ignore="HardcodedText" />
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottieAnimationView"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="15dp"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/warning_status"
                        />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/backgound_mine_main"
                    android:elevation="7dp"
                    android:orientation="horizontal"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    tools:ignore="DuplicateIds">



                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        >

                        <ImageView
                            android:id="@+id/btnThirdOfNight"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:clickable="true"
                            app:tint="@color/icon_mine_color"
                            android:src="@drawable/moon_stars"
                            tools:ignore="ContentDescription,DuplicateIds,SpeakableTextPresentCheck,TouchTargetSizeCheck" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="سێیەکی شەو"
                            android:fontFamily="@font/rabar015"
                            android:textColor="@color/textColorBlack"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:textSize="10sp"/>

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginStart="20dp"
                        android:background="#DCD3CA" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        >

                        <ImageView
                            android:id="@+id/btnBang"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:clickable="true"
                            app:tint="@color/icon_mine_color"
                            android:src="@drawable/mosque_moon"
                            tools:ignore="ContentDescription,DuplicateIds,SpeakableTextPresentCheck,TouchTargetSizeCheck" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="بانگ"
                            android:fontFamily="@font/rabar015"
                            android:textColor="@color/textColorBlack"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:textSize="10sp"/>

                    </LinearLayout>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginStart="20dp"
                        android:background="#DCD3CA" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        tools:ignore="DuplicateIds">

                        <ImageView
                            android:id="@+id/btnAya"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:clickable="true"
                            app:tint="@color/icon_mine_color"
                            android:src="@drawable/ic_quran"
                            tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ئایەتی کورسی"
                            android:fontFamily="@font/rabar015"
                            android:textColor="@color/textColorBlack"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:textSize="10sp"/>

                    </LinearLayout>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginStart="20dp"
                        android:background="#DCD3CA" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        >

                        <ImageView
                            android:id="@+id/calender"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:clickable="true"
                            app:tint="@color/icon_mine_color"
                            android:src="@drawable/ic_calendar"
                            tools:ignore="ContentDescription,DuplicateIds,SpeakableTextPresentCheck,TouchTargetSizeCheck" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ڕۆژ ژمێر"
                            android:fontFamily="@font/rabar015"
                            android:textColor="@color/textColorBlack"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:textSize="10sp"/>

                    </LinearLayout>

                </LinearLayout>




                <HorizontalScrollView
                    android:id="@+id/scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayout"
                    >
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        >

                        <androidx.cardview.widget.CardView
                            android:id="@+id/Bayanyan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="8dp"
                            app:cardUseCompatPadding="true">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:background="@drawable/bayani_bg"
                                android:orientation="horizontal"
                                tools:ignore="UseCompoundDrawables">

                                <ImageView
                                    android:id="@+id/imageView"
                                    android:layout_width="@dimen/_30sdp"
                                    android:layout_height="@dimen/_30sdp"
                                    android:src="@drawable/sunset1"
                                    app:tint="@color/white"
                                    android:alpha="0.3"
                                    android:layout_margin="10dp"
                                    tools:ignore="ContentDescription,ImageContrastCheck,TooDeepLayout" />

                                <TextView
                                    android:id="@+id/textView7"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:fontFamily="@font/rabar015"
                                    android:gravity="center"
                                    android:layout_marginEnd="5dp"
                                    android:text=" زیکرەکانی بەیانیان"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/_12sdp"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText,TextContrastCheck,TextSizeCheck" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/Ewaran"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="8dp"
                            app:cardUseCompatPadding="true">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/maghrib_bg"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="horizontal"
                                >

                                <ImageView
                                    android:id="@+id/imageView1"
                                    android:layout_width="@dimen/_30sdp"
                                    android:layout_height="@dimen/_30sdp"
                                    android:src="@drawable/sunset"
                                    android:layout_margin="10dp"
                                    app:tint="@color/white"
                                    android:alpha="0.3"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    android:id="@+id/textView71"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/rabar015"
                                    android:text=" زیکرەکانی ئێواران"
                                    android:textColor="@color/white"
                                    android:layout_marginEnd="5dp"
                                    android:textSize="@dimen/_12sdp"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText,TextContrastCheck,TextSizeCheck" />


                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/xewtnan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="8dp"
                            app:cardUseCompatPadding="true">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:background="@drawable/isha_bg"
                                android:orientation="horizontal"
                                >

                                <ImageView
                                    android:id="@+id/imageView2"
                                    android:layout_width="@dimen/_30sdp"
                                    android:layout_height="@dimen/_30sdp"
                                    android:src="@drawable/night_moon"
                                    app:tint="@color/white"
                                    android:alpha="0.3"
                                    android:layout_margin="10dp"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    android:id="@+id/textView72"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/rabar015"
                                    android:text=" زیکرەکانی خەوتنان"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/_12sdp"
                                    android:layout_marginEnd="5dp"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText,TextContrastCheck,TextSizeCheck"

                                    />


                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:id="@+id/ActRecyclerView"
                    />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

</LinearLayout>


    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <include
            layout="@layout/custom_navigation_view"
            android:layout_width="280dp"
            android:layout_height="match_parent"/>

    </FrameLayout>



</androidx.drawerlayout.widget.DrawerLayout>